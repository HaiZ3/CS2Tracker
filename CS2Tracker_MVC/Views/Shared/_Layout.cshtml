
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CS2 Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md app-navbar">
            <div class="container">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                <a class="navbar-brand" asp-controller="Sheets" asp-action="All">
                    CS2 <span>Tracker</span>
                </a>
                    }
                    else
                    {
                <a class="navbar-brand" asp-controller="Home" asp-action="Home">
                    CS2 <span>Tracker</span>
                </a>
                    }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                         <partial name="Nav/_NavAuthenticated" />
                    }
                    else
                    {
                         <partial name="Nav/_NavNotAuthenticated" />
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">

@if (TempData["SuccessMessage"] != null)
{
    <div class="app-alert app-alert-success" role="alert">
        <span class="app-alert-icon">✓</span>
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="app-alert-close"
                onclick="this.parentElement.remove()"
                aria-label="Close">
            &times;
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="app-alert app-alert-error" role="alert">
        <span class="app-alert-icon">!</span>
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="app-alert-close"
                onclick="this.parentElement.remove()"
                aria-label="Close">
            &times;
        </button>
    </div>
}

        
@RenderBody()

    </main>

    <footer class="app-footer">
        <div class="container">&copy; @DateTime.UtcNow.Year CS2 Tracker</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
