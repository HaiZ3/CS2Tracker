@model EntryDisplayDTO
@{
    var shownProfit = Model.Profit ?? Model.UnrealizedProfit;
    var isUnrealized = Model.Profit is null && Model.UnrealizedProfit is not null;
    var profitClass = shownProfit > 0 ? "profit-pos" : shownProfit < 0 ? "profit-neg" : "";
}
<tr>
    <td>@Model.Name</td>
    <td>@Model.Status</td>
    <td>
        @Model.DateBought.ToString(DateFormat) →
        @(Model.DateSold.HasValue ? Model.DateSold.Value.ToString(DateFormat) : "-")
    </td>
    <td>$@Model.BuyPrice.ToString("0.00")</td>
    <td>@(Model.SellPrice.HasValue ? $"${Model.SellPrice.Value:0.00}" : "-")</td>
    <td>
        @(Model.Allocation.HasValue ? Model.Allocation.Value.ToString("P2") : "-")
    </td>
    <td class="@profitClass @(isUnrealized ? "profit-unrealized" : "")"
        title="@(isUnrealized ? "Unrealized: based on the higher current market price (fees not included!)" : "")">
        @(shownProfit.HasValue ? $"${shownProfit.Value:0.00}" : "-")
    </td>
    <td class="@(Model.ReturnPercent > 0 ? "profit-pos" : Model.ReturnPercent < 0 ? "profit-neg" : "")">
        @(Model.ReturnPercent.HasValue ? $"{Model.ReturnPercent.Value:0.00}%" : "-")
    </td>
    <td class="text-center">@(Model.HoldDays.HasValue ? $"{Model.HoldDays.Value} d" : "Open")</td>
    <td>
        @if (Model.CsFloatPrice.HasValue && Model.CsFloatUrl != null)
        {
            <a href="@Model.CsFloatUrl" target="_blank" rel="noopener noreferrer">$@Model.CsFloatPrice.Value.ToString("0.00")</a>
        }
        else
        {
            <span>-</span>
        }
    </td>
    <td>
        @if (Model.YouPinPrice.HasValue && Model.YouPinUrl != null)
        {
            <a href="@Model.YouPinUrl" target="_blank" rel="noopener noreferrer">$@Model.YouPinPrice.Value.ToString("0.00")</a>
        }
        else
        {
            <span>-</span>
        }
    </td>
    <td class="entry-actions">
        @if (Model.Status == "Open")
        {
            <a class="btn-icon btn-icon-edit" asp-controller="Entries" asp-action="Edit" asp-route-id="@Model.Id"
               title="Edit entry" aria-label="Edit entry">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                </svg>
            </a>

            <a class="btn btn-app-outline btn-sm btn-glow" asp-controller="Entries" asp-action="Close" asp-route-id="@Model.Id">Close</a>
        }

        <form asp-controller="Entries" asp-action="Delete" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Delete this entry? This cannot be undone.');">
            <input type="hidden" name="sheetId" value="@ViewData["SheetId"]" />
            <button type="submit" class="btn-icon btn-icon-danger" title="Delete entry" aria-label="Delete entry">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                </svg>
            </button>
        </form>
    </td>
</tr>