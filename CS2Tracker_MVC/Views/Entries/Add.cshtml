@model CreateEntryViewModel
@using CS2Tracker_MVC.ViewModels.Entries
@{
    ViewData["Title"] = "Add entry";
}

<div class="sheet-form-container">
    <div class="sheet-form-card">
        <div class="sheet-form-header">
            <h1 class="page-title">Add entry</h1>
            <p class="sheet-form-subtitle">Record a skin you bought.</p>
        </div>

        <form asp-controller="Entries" asp-action="Add" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <input type="hidden" asp-for="SheetId" />

            <div class="mb-3 suggest-wrapper">
                <label asp-for="SkinName" class="form-label"></label>
                <input asp-for="SkinName" class="form-control" autofocus autocomplete="off"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="skinSuggestions" />
                <div id="skinSuggestions" class="suggest-menu" role="listbox" hidden></div>
                <span asp-validation-for="SkinName" class="field-error"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateBought" class="form-label"></label>
                    <input asp-for="DateBought" type="date" class="form-control" />
                    <span asp-validation-for="DateBought" class="field-error"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="BuyPrice" class="form-label"></label>
                    <input asp-for="BuyPrice" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="BuyPrice" class="field-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Float" class="form-label"></label>
                <input asp-for="Float" type="number" step="0.000001" min="0" max="1" class="form-control" />
                <span asp-validation-for="Float" class="field-error"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label asp-for="SkinVariant" class="form-label"></label>
                    <select asp-for="SkinVariant" asp-items="Html.GetEnumSelectList<SkinVariant>()" class="form-select"></select>
                    <span asp-validation-for="SkinVariant" class="field-error"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="SkinCondition" class="form-label"></label>
                    <select asp-for="SkinCondition" asp-items="Html.GetEnumSelectList<SkinCondition>()" class="form-select"></select>
                    <span asp-validation-for="SkinCondition" class="field-error"></span>
                </div>
            </div>

            <div class="sheet-form-actions">
                <a class="btn btn-app-outline" asp-controller="Sheets" asp-action="Details" asp-route-id="@Model.SheetId">Cancel</a>
                <button type="submit" class="btn btn-app-primary">Add entry</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('SkinName');
            const menu = document.getElementById('skinSuggestions');
            let timer, controller, items = [], active = -1;

            function close() {
                menu.hidden = true;
                menu.replaceChildren();
                items = [];
                active = -1;
                input.setAttribute('aria-expanded', 'false');
            }

            function setActive(index) {
                items.forEach((el, i) => el.classList.toggle('active', i === index));
                active = index;
                items[index]?.scrollIntoView({ block: 'nearest' });
            }

            function pick(name) {
                input.value = name;
                close();
                input.focus();
            }

            function highlight(name, query) {
                const frag = document.createDocumentFragment();
                const idx = name.toLowerCase().indexOf(query.toLowerCase());
                if (idx < 0) {
                    frag.append(name);
                    return frag;
                }
                const mark = document.createElement('mark');
                mark.textContent = name.slice(idx, idx + query.length);
                frag.append(name.slice(0, idx), mark, name.slice(idx + query.length));
                return frag;
            }

            function render(names, query) {
                if (names.length === 0) return close();

                menu.replaceChildren();
                items = names.map(name => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'suggest-item';
                    btn.setAttribute('role', 'option');
                    btn.append(highlight(name, query));
                    // mousedown + preventDefault keeps focus in the input so the click registers
                    btn.addEventListener('mousedown', e => {
                        e.preventDefault();
                        pick(name);
                    });
                    menu.append(btn);
                    return btn;
                });

                menu.hidden = false;
                input.setAttribute('aria-expanded', 'true');
                setActive(-1);
            }

            async function fetchSuggestions(query) {
                controller?.abort();
                controller = new AbortController();
                try {
                    const res = await fetch(`/Entries/SkinSuggestions?q=${encodeURIComponent(query)}`,
                        { signal: controller.signal });
                    if (!res.ok) return close();
                    render(await res.json(), query);
                } catch (err) {
                    if (err.name !== 'AbortError') close();
                }
            }

            input.addEventListener('input', () => {
                clearTimeout(timer);
                const query = input.value.trim();
                if (query.length < 2) {
                    controller?.abort();
                    return close();
                }
                timer = setTimeout(() => fetchSuggestions(query), 200);
            });

            input.addEventListener('keydown', e => {
                if (menu.hidden) return;
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    setActive((active + 1) % items.length);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    setActive(active <= 0 ? items.length - 1 : active - 1);
                } else if (e.key === 'Enter' && active >= 0) {
                    e.preventDefault();
                    pick(items[active].textContent);
                } else if (e.key === 'Escape') {
                    close();
                }
            });

            document.addEventListener('click', e => {
                if (!e.target.closest('.suggest-wrapper')) close();
            });
        })();
    </script>
}