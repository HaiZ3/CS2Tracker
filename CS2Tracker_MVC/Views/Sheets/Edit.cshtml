@model SheetEditDTO

@{
    ViewData["Title"] = "Edit Sheet";
}

<div class="sheet-form-container">
    <div class="sheet-form-card">

        <div class="sheet-form-header">
            <h1 class="page-title">Edit sheet</h1>
            <p class="sheet-form-subtitle">
                Update the name or type of this sheet.
            </p>
        </div>

        <form asp-controller="Sheets" asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label">
                    Name
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="e.g. Main Arbitrage" />

                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Type" class="form-label">
                    Type
                </label>

                <select asp-for="Type"
                        asp-items="Html.GetEnumSelectList<SheetType>()"
                        class="form-select">
                    <option value="">Select a sheet type</option>
                </select>

                <span asp-validation-for="Type" class="field-error"></span>
            </div>

            <div class="sheet-form-actions">
                <a asp-controller="Sheets"
                   asp-action="All"
                   class="btn btn-app-outline">
                    Cancel
                </a>

                <button type="submit" class="btn btn-app-primary">
                    Save changes
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}