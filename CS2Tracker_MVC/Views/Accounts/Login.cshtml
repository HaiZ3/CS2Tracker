@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Log in to your CS2 Tracker account.</p>

    <form asp-action="Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-app-primary w-100">Login</button>
    </form>

    <p class="auth-footer">
        Don't have an account?
        <a asp-action="Register">Register</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}