@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <h1 class="auth-title">Create an account</h1>
    <p class="auth-subtitle">Start tracking your CS2 trades.</p>

    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

            <button type="submit" class="btn btn-app-primary w-100">Register</button>

    </form>

    <p class="auth-footer">
        Already have an account?
        <a asp-action="Login">Login</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}