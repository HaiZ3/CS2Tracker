@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <h1 class="mb-2">CS2Tracker</h1>
    <p class="text-muted mb-4">
        Your CS2 investment portfolio at a glance.
    </p>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Invested</h6>
                    <h3>€0.00</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Realized Profit</h6>
                    <h3>€0.00</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Open Positions</h6>
                    <h3>0</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Unrealized Profit</h6>
                    <h3>€0.00</h3>
                </div>
            </div>
        </div>
    </div>
</div>